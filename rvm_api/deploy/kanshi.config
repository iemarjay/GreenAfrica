# GreenAfrica RVM — display orientation for the Pi's 4" MPI4008 panel.
#
# Managed by kanshi, the labwc display-config daemon that Raspberry Pi OS starts
# from /etc/xdg/labwc/autostart on every session. The panel is a 480x800
# portrait output; transform 90 rotates it to 800x480 landscape. Display AND
# touch follow the output transform.
#
# Install once on the Pi so orientation persists across reboots (a live
# `wlr-randr --transform` reverts on reboot):
#     mkdir -p ~/.config/kanshi
#     cp ~/rvm_api/deploy/kanshi.config ~/.config/kanshi/config
#
# This replaces the old approach of rotating inside the kiosk launcher —
# orientation is a display concern, not a kiosk-app concern.
profile {
	output HDMI-A-1 transform 90
}
