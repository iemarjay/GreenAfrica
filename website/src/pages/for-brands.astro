---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ClosingBand from "../components/ClosingBand.astro";
import FramedPhoto from "../components/FramedPhoto.astro";
import photos from "../data/photos.json";
import imgCompliance from "../assets/photos/brands-compliance.jpg";

const deliverables = [
  {
    lead: "Point-of-recovery capture.",
    text: "The record is created at the machine, when the bottle is verified, rather than reconstructed afterwards from weighbridge tickets.",
  },
  {
    lead: "Independent verification.",
    text: "Records go to a public ledger and you can query them yourself. Once an entry is there we cannot change it, and neither can anyone else.",
  },
  {
    lead: "Unit-level granularity.",
    text: "Item counts rather than tonnage estimates, with material grade, location and timestamp on every record.",
  },
  {
    lead: "Reconciliation to physical material.",
    text: "Deposit records tie through to baled tonnage leaving the hub, so the data and the material agree.",
  },
  {
    lead: "Attribution that can't be sold twice.",
    text: "A recovery event belongs to one claim.",
  },
];

const engagements = [
  {
    title: "Sponsor a location",
    text: "Fund machines at sites where your product is actually consumed: campuses, gyms, retail forecourts, event venues. Recovery is attributed to your obligation, and you have a visible presence where your customers already are.",
  },
  {
    title: "Buy verified recovery",
    text: "Contract for volume against verified records rather than a certificate.",
  },
  {
    title: "Run a takeback with real numbers",
    text: "Campaign activity that reports itself, with numbers you can publish as they are.",
  },
];

const straightAnswers = [
  {
    lead: "We're pre-scale.",
    text: "Deployment is underway now, with the first machines going into the ground and more in fabrication. Continental-scale tonnage is not something we can offer today. What we can offer is a place early in a verification chain that is still being designed around real obligations.",
  },
  {
    lead: "We don't sell offsets.",
    text: "We produce evidence of physical recovery. What you do with it under your regulatory framework is properly your call and your advisors'.",
  },
  {
    lead: "Verification has limits.",
    text: "The machine proves an empty PET bottle of a given weight was deposited at a given place and time. It does not prove the bottle was originally yours. Where attribution matters, we handle it through sited placement and contracted volume, and we'll be specific about the limits of what the data supports.",
  },
];
---

<Base
  title="Verified recovery data for EPR compliance — Green Africa"
  description="Independently checkable proof of plastic recovery, recorded at the point of collection and reconciled to baled tonnage."
>
  <PageHero
    eyebrow="For brands & EPR buyers"
    headline="Your recovery claims, backed by something other than our word."
    subhead="Green Africa produces recovery data an auditor can verify without a site visit, because the records are not ours to edit."
  />

  <!-- The compliance problem -->
  <section class="rule-t">
    <div class="container-x grid gap-10 py-16 sm:py-20 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow text-leaf">01 — The compliance problem</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance">
          Recovery certificates are self-issued.
        </h2>
        <FramedPhoto
          src={imgCompliance}
          alt={photos["brands-compliance"].alt}
          credit={`Photo: ${photos["brands-compliance"].photographer} / Pexels`}
          class="mt-8"
        />
      </div>
      <div class="space-y-5 text-base leading-relaxed text-ink/75 lg:col-span-6 lg:col-start-7" data-reveal style="--d:120ms">
        <p>
          Producer responsibility obligations are tightening across the continent, and the reporting
          expected under them has outrun what most collection chains can evidence. The typical
          recovery certificate is a document produced by the same party that was paid to do the
          recovery. It may well be accurate, but nobody outside the transaction can confirm that,
          and the distinction matters more each year to regulators, to auditors, and to anyone whose
          sustainability disclosures now sit under assurance.
        </p>
        <p>
          Double counting is the specific risk. The same tonne, sold to two obligated parties,
          leaves no trace in a paper chain.
        </p>
      </div>
    </div>
  </section>

  <!-- What we give you -->
  <section class="rule-t">
    <div class="container-x py-16 sm:py-20">
      <p class="eyebrow text-leaf">02 — What we give you</p>
      <div class="mt-10 border-t border-ink/10">
        {
          deliverables.map((item, index) => (
            <div
              class="grid gap-2 border-b border-ink/10 py-6 sm:grid-cols-12 sm:gap-6"
              data-reveal
              style={`--d:${index * 60}ms`}
            >
              <p class="font-mono text-sm text-leaf sm:col-span-1">
                {String(index + 1).padStart(2, "0")}
              </p>
              <p class="font-semibold tracking-tight sm:col-span-4">{item.lead}</p>
              <p class="text-sm leading-relaxed text-ink/65 sm:col-span-7">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How brands work with us -->
  <section class="rule-t">
    <div class="container-x py-16 sm:py-20">
      <p class="eyebrow text-leaf">03 — How brands work with us</p>
      <div class="mt-10 grid gap-px border border-ink/10 bg-ink/10 md:grid-cols-3">
        {
          engagements.map((item, index) => (
            <article class="bg-paper p-7 sm:p-8" data-reveal style={`--d:${index * 100}ms`}>
              <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Straight answers -->
  <section class="bg-sand/60">
    <div class="container-x py-16 sm:py-20">
      <p class="eyebrow text-leaf">04 — Straight answers</p>
      <div class="mt-10 max-w-3xl space-y-8">
        {
          straightAnswers.map((item, index) => (
            <p
              class="border-l-2 border-leaf pl-5 text-base leading-relaxed text-ink/75"
              data-reveal
              style={`--d:${index * 80}ms`}
            >
              <strong class="font-semibold text-ink">{item.lead}</strong> {item.text}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <ClosingBand
    headline="Bring us your reporting requirement."
    body="Tell us what your filing or your assurance provider needs to see, and we can tell you in one conversation whether our records meet it."
  />
</Base>
