---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ClosingBand from "../components/ClosingBand.astro";
import FramedPhoto from "../components/FramedPhoto.astro";
import photos from "../data/photos.json";
import imgInsert from "../assets/photos/step-insert.jpg";
import imgVerify from "../assets/photos/verify-conveyor.jpg";
import imgReward from "../assets/photos/pay-phone.jpg";
import imgConsolidate from "../assets/photos/step-consolidate.jpg";
import imgReconcile from "../assets/photos/record-ledger.jpg";

const credit = (slug: keyof typeof photos) => `Photo: ${photos[slug].photographer} / Pexels`;

const steps = [
  {
    number: "01",
    title: "Insert",
    paragraphs: [
      "A recycler walks up to a Green Africa station. It looks more like an ATM than a bin: an enclosed steel cabinet, weather-sealed, with nothing exposed to smell or to vandalise. They feed in one bottle at a time.",
      "One at a time is deliberate. It keeps the mechanism simple enough to repair with a screwdriver, and it means every bottle gets its own verification and its own record. A machine that swallows a whole bag at once can only estimate what was in it.",
    ],
    image: imgInsert,
    imageAlt: photos["step-insert"].alt,
    imageCredit: credit("step-insert"),
  },
  {
    number: "02",
    title: "Verify",
    paragraphs: [
      "Inside the chamber the bottle comes to rest in front of a fixed camera under controlled light. A small neural network running on the machine's onboard computer classifies it: whether it is PET, of the right grade and the right shape. A load cell checks the weight, which rejects a full or part-full bottle, and also catches one that has been fed back in for a second payout.",
      "The whole check takes about a second. No internet connection required.",
    ],
    image: imgVerify,
    imageAlt: photos["verify-conveyor"].alt,
    imageCredit: credit("verify-conveyor"),
  },
  {
    number: "03",
    title: "Reward",
    paragraphs: [
      "The machine sends airtime or data to the number the recycler entered. Value lands immediately.",
      "We pay in airtime and data rather than cash. Cash inside a street-level machine is a reason to attack it. Airtime also reaches people who have no bank account, and it is spendable the moment it arrives.",
    ],
    image: imgReward,
    imageAlt: photos["pay-phone"].alt,
    imageCredit: credit("pay-phone"),
  },
  {
    number: "04",
    title: "Record",
    paragraphs: [
      "The verified deposit is signed on the device and queued locally. When the machine has connectivity, the record is submitted to Hedera's consensus network. Because records are hash-chained on the device before they're sent, a gap in the network can't be used to quietly insert, alter or delete a deposit after the fact.",
      "The ledger entry holds a timestamp, a machine identifier, a material classification and a weight. It holds nothing personal about the person who made the deposit.",
    ],
  },
  {
    number: "05",
    title: "Consolidate",
    paragraphs: [
      "Machines are light-crush units, compacting bottles on the spot. Loose PET is mostly air, and paying road freight to move air is what ruins collection margins. Filled units are emptied on a route and consolidated at a central bale hub, where material is graded, baled and prepared for offtake.",
    ],
    streams: [
      { material: "Clear PET", handling: "Primary stream — highest-value grade" },
      { material: "Light-blue tinted PET", handling: "Accepted at a discount" },
      { material: "Coloured PET", handling: "Segregated" },
      { material: "PVC", handling: "Refused outright — a small amount ruins an entire PET batch" },
    ],
    image: imgConsolidate,
    imageAlt: photos["step-consolidate"].alt,
    imageCredit: credit("step-consolidate"),
  },
  {
    number: "06",
    title: "Reconcile",
    paragraphs: [
      "Every bale carries back to the deposits that made it. Machine-level records roll up to route level, route to hub, hub to shipment. When a tonne leaves the hub, the ledger can account for where it came from.",
      "That reconciliation is the product.",
    ],
    image: imgReconcile,
    imageAlt: photos["record-ledger"].alt,
    imageCredit: credit("record-ledger"),
  },
];
---

<Base
  title="How it works — Green Africa"
  description="How a bottle becomes a bale and a verified record, step by step through the Green Africa recovery chain."
>
  <PageHero
    eyebrow="How it works"
    headline="From bottle to bale, with a receipt at every step."
    subhead="The whole chain, one step at a time."
  />

  <div class="container-x pb-20 sm:pb-28">
    <div class="border-t border-ink/10">
      {
        steps.map((step) => (
          <section class="grid gap-6 border-b border-ink/10 py-12 sm:py-14 lg:grid-cols-12" data-reveal>
            <div class="lg:col-span-4">
              <p class="font-mono text-sm text-leaf">Step {step.number}</p>
              <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{step.title}</h2>
            </div>
            <div class="space-y-5 text-base leading-relaxed text-ink/75 lg:col-span-7 lg:col-start-6">
              {step.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {step.image && (
                <FramedPhoto
                  src={step.image}
                  alt={step.imageAlt}
                  credit={step.imageCredit}
                  ratio="aspect-[16/9]"
                  class="mt-2"
                />
              )}

              {step.streams && (
                <div class="mt-2 border border-ink/15">
                  <p class="border-b border-ink/15 bg-sand/60 px-4 py-2.5 font-mono text-[11px] uppercase tracking-[0.18em] text-ink/60">
                    What the machine accepts
                  </p>
                  <dl>
                    {step.streams.map((stream) => (
                      <div class="grid gap-1 border-b border-ink/10 px-4 py-3 last:border-b-0 sm:grid-cols-3 sm:gap-4">
                        <dt class="text-sm font-semibold">{stream.material}</dt>
                        <dd class="text-sm text-ink/65 sm:col-span-2">{stream.handling}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <ClosingBand
    headline="Questions we're happy to answer properly."
    body="How do you handle contamination, what's the uptime, and what happens when someone tries to game it? Ask, and we'll tell you where it works and where it is still difficult."
  />
</Base>
