---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  credit?: string;
  ratio?: string;
  dark?: boolean;
  class?: string;
}

const {
  src,
  alt,
  credit,
  ratio = "aspect-[4/3]",
  dark = false,
  class: className,
} = Astro.props;
---

<figure
  class:list={[
    "border",
    dark ? "border-mint/25 bg-pine-deep" : "border-ink/15 bg-white",
    className,
  ]}
>
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1200]}
    sizes="(min-width: 1024px) 34vw, 100vw"
    class:list={["w-full object-cover", ratio]}
  />
  {
    credit && (
      <figcaption
        class:list={[
          "ledger-chip border-t px-4 py-2 text-right",
          dark ? "border-mint/20 text-paper/40" : "border-ink/10 text-ink/45",
        ]}
      >
        {credit}
      </figcaption>
    )
  }
</figure>
