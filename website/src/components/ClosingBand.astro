---
interface Props {
  headline: string;
  body?: string;
  label?: string;
}

const { headline, body, label = "Write to us" } = Astro.props;
---

<section class="bg-pine text-paper">
  <div class="container-x py-16 sm:py-20">
    <div class="grid items-end gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow text-leaf-bright">{label}</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          {headline}
        </h2>
        {body && <p class="mt-5 max-w-xl text-base leading-relaxed text-paper/70">{body}</p>}
      </div>
      <div class="lg:col-span-5 lg:text-right" data-reveal style="--d:120ms">
        <a
          href="mailto:greenafrica@amp10.company"
          class="group inline-flex items-center gap-3 border border-mint/30 px-6 py-4 font-mono text-sm text-mint transition-colors hover:border-leaf-bright hover:bg-leaf hover:text-white sm:text-base"
        >
          greenafrica@amp10.company
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
        <p class="mt-4 font-mono text-xs text-paper/40">We reply within two working days.</p>
      </div>
    </div>
  </div>
</section>
